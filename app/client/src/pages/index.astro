---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GoldPulse AI | XAU/USD Paper Trading">
  <section class="dashboard" id="overview">
    <div class="intro-row">
      <div>
        <div class="eyebrow"><span></span> Gold intelligence workspace</div>
        <h1>Trade with context,<br /><em>not conviction.</em></h1>
        <p class="intro-copy">
          A transparent XAU/USD paper-trading desk built around disciplined signals,
          defined risk, and the confidence to wait.
        </p>
      </div>

      <div class="scan-card">
        <div class="scan-orb" aria-hidden="true">
          <svg viewBox="0 0 46 46" fill="none">
            <circle cx="23" cy="23" r="18" stroke="currentColor" stroke-opacity=".2"></circle>
            <circle cx="23" cy="23" r="12" stroke="currentColor" stroke-opacity=".5"></circle>
            <path d="M23 13v10l6.5 4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
          </svg>
        </div>
        <div>
          <span>Next automatic scan</span>
          <strong data-countdown>07:46</strong>
          <small>Monitors every 15 minutes</small>
        </div>
        <button class="icon-button" type="button" data-run-analysis aria-label="Run analysis now">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M20 12a8 8 0 1 1-2.34-5.66" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            <path d="M20 4v5h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="metrics-grid" id="portfolio">
      <article class="metric-card balance-card">
        <div class="metric-heading">
          <span>Paper balance</span>
          <span class="metric-icon gold">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7.5 7.2 4h9.6L20 7.5v8L16.8 19H7.2L4 15.5v-8Z" stroke="currentColor" stroke-width="1.55"></path>
              <path d="M8.1 10.2h7.8M8.1 13.8h5.1" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"></path>
            </svg>
          </span>
        </div>
        <strong>$10,482<span>.60</span></strong>
        <div class="metric-footer"><span class="positive">+$482.60</span><span>since start</span></div>
      </article>

      <article class="metric-card">
        <div class="metric-heading">
          <span>Total P&amp;L</span>
          <span class="metric-icon green">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m5 15 4-4 3 3 6-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M14 7h4v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </div>
        <strong class="positive-text">+$482.60</strong>
        <div class="metric-footer"><span class="positive">+4.83%</span><span>all time</span></div>
      </article>

      <article class="metric-card">
        <div class="metric-heading">
          <span>Win rate</span>
          <span class="metric-icon blue">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"></circle>
              <path d="M12 7v5l3.2 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </span>
        </div>
        <strong>62.5<span>%</span></strong>
        <div class="metric-footer"><span>10 wins</span><span>· 6 losses</span></div>
      </article>

      <article class="metric-card risk-metric">
        <div class="metric-heading">
          <span>Daily risk used</span>
          <span class="metric-icon coral">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 4 4.5 18h15L12 4Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"></path>
              <path d="M12 9v4.2M12 15.7v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </span>
        </div>
        <strong>1.4<span>%</span></strong>
        <div class="risk-bar"><i></i></div>
        <div class="metric-footer"><span>Limit: 3.0%</span><span class="safe">Safe</span></div>
      </article>
    </div>

    <div class="workspace-grid">
      <div class="left-column">
        <article class="panel chart-panel">
          <div class="panel-head">
            <div>
              <div class="panel-kicker">Live market</div>
              <div class="instrument-title">
                <h2>XAU/USD</h2>
                <span>Gold / US Dollar</span>
                <span class="open-market"><i></i> Open</span>
              </div>
            </div>
            <div class="price-stack">
              <strong>$2,175.42</strong>
              <span class="positive">+0.31% <small>+$6.73</small></span>
            </div>
          </div>

          <div class="chart-toolbar">
            <div class="chart-legend"><i></i> Bid <span>2,175.42</span></div>
            <div class="range-controls" role="group" aria-label="Chart range">
              <button type="button" data-chart-range>1H</button>
              <button type="button" class="selected" data-chart-range>4H</button>
              <button type="button" data-chart-range>1D</button>
              <button type="button" data-chart-range>1W</button>
            </div>
          </div>

          <div class="chart-wrap">
            <div class="chart-scale chart-scale-left">
              <span>2,180</span><span>2,175</span><span>2,170</span><span>2,165</span>
            </div>
            <svg class="price-chart" viewBox="0 0 760 270" preserveAspectRatio="none" role="img" aria-label="XAU/USD chart rising through the current session">
              <defs>
                <linearGradient id="price-fill" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0%" stop-color="#78e6af" stop-opacity=".27"></stop>
                  <stop offset="100%" stop-color="#78e6af" stop-opacity="0"></stop>
                </linearGradient>
                <filter id="chart-glow" x="-20%" y="-30%" width="140%" height="160%">
                  <feGaussianBlur stdDeviation="3" result="blur"></feGaussianBlur>
                  <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
                </filter>
              </defs>
              <g class="grid-lines">
                <path d="M0 25H760M0 85H760M0 145H760M0 205H760M0 265H760"></path>
                <path d="M95 0V270M250 0V270M405 0V270M560 0V270M715 0V270"></path>
              </g>
              <path class="area-fill" d="M0 214 C24 207 34 226 57 210 S88 180 111 193 S151 205 173 176 S212 130 241 153 S280 182 305 146 S346 100 372 119 S411 152 439 130 S468 81 499 95 S533 118 561 94 S594 73 620 90 S660 112 684 67 S718 49 760 35 V270 H0Z"></path>
              <path class="price-line" filter="url(#chart-glow)" d="M0 214 C24 207 34 226 57 210 S88 180 111 193 S151 205 173 176 S212 130 241 153 S280 182 305 146 S346 100 372 119 S411 152 439 130 S468 81 499 95 S533 118 561 94 S594 73 620 90 S660 112 684 67 S718 49 760 35"></path>
              <path class="ma-line" d="M0 199 C75 188 104 193 174 166 S260 145 321 137 S412 137 483 111 S575 98 638 86 S702 65 760 53"></path>
              <g class="current-point">
                <circle cx="760" cy="35" r="8"></circle>
                <circle cx="760" cy="35" r="3.5"></circle>
              </g>
            </svg>
            <div class="price-tag">$2,175.42</div>
            <div class="chart-time"><span>06:00</span><span>08:00</span><span>10:00</span><span>12:00</span><span>14:00</span></div>
          </div>

          <div class="indicator-strip">
            <div><span>RSI (14)</span><strong class="amber-text">58.4</strong></div>
            <div><span>MACD</span><strong class="positive-text">+1.82</strong></div>
            <div><span>Trend</span><strong>Upward</strong></div>
            <div><span>Volatility</span><strong class="muted">Moderate</strong></div>
          </div>
        </article>

        <article class="panel decision-panel" id="signals">
          <div class="decision-top">
            <div>
              <div class="panel-kicker">AI decision engine</div>
              <h2>Current market call</h2>
            </div>
            <span class="updated-time" data-analysis-status>Updated just now</span>
          </div>

          <div class="decision-content">
            <div class="signal-call wait">
              <span class="signal-dot"></span>
              <div>
                <small>Recommendation</small>
                <strong>WAIT</strong>
              </div>
              <span class="confidence">64% confidence</span>
            </div>
            <p>
              Momentum is positive, but price remains inside a narrow intraday range.
              Wait for a confirmed close above <b>$2,178.20</b> or below <b>$2,169.80</b>.
            </p>
          </div>

          <div class="decision-factors">
            <div class="factor">
              <div><span>Technical</span><strong>68 / 100</strong></div>
              <div class="factor-bar"><i style="width: 68%"></i></div>
              <small>Trend supports buyers, breakout unconfirmed.</small>
            </div>
            <div class="factor">
              <div><span>News &amp; sentiment</span><strong>51 / 100</strong></div>
              <div class="factor-bar amber"><i style="width: 51%"></i></div>
              <small>Neutral USD outlook before Fed remarks.</small>
            </div>
            <div class="factor">
              <div><span>Risk environment</span><strong>72 / 100</strong></div>
              <div class="factor-bar blue"><i style="width: 72%"></i></div>
              <small>Volatility is within the daily risk plan.</small>
            </div>
          </div>
        </article>
      </div>

      <aside class="right-column">
        <article class="panel trade-panel">
          <div class="panel-head compact">
            <div>
              <div class="panel-kicker">Paper trade plan</div>
              <h2>Define before you decide</h2>
            </div>
            <span class="shield-icon" aria-label="Risk controls enabled">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 3.6 19 6v5.16c0 4.32-2.97 7.68-7 9.24-4.03-1.56-7-4.92-7-9.24V6l7-2.4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                <path d="m8.8 12.1 2.1 2.1 4.4-4.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>

          <div class="duration-field">
            <div class="field-label">
              <span>Trade duration</span>
              <strong data-duration-summary>10-minute balanced setup</strong>
            </div>
            <div class="duration-options" role="group" aria-label="Trade duration">
              <button type="button" data-duration="5" aria-pressed="false"><strong>5</strong><span>min</span></button>
              <button type="button" class="selected" data-duration="10" aria-pressed="true"><strong>10</strong><span>min</span></button>
              <button type="button" data-duration="15" aria-pressed="false"><strong>15</strong><span>min</span></button>
            </div>
          </div>

          <div class="plan-price">
            <div><span>Potential entry</span><strong>$2,175.42</strong></div>
            <span class="entry-note">Awaiting confirmation</span>
          </div>

          <div class="risk-values">
            <div>
              <span>Take profit</span>
              <strong class="positive-text" data-take-profit>$2,181.30</strong>
              <small data-potential-profit>+$29.40 potential</small>
            </div>
            <div>
              <span>Stop loss</span>
              <strong class="negative-text" data-stop-loss>$2,172.48</strong>
              <small data-potential-loss>-$14.70 max loss</small>
            </div>
          </div>

          <div class="position-row">
            <span>Position size</span>
            <div class="size-control"><button type="button" aria-label="Decrease position size">−</button><strong>0.10</strong><span>lots</span><button type="button" aria-label="Increase position size">+</button></div>
          </div>

          <div class="ratio-row"><span>Risk / reward</span><strong data-risk-ratio>1 : 2.0</strong></div>

          <div class="trade-actions">
            <button class="buy-button" type="button" data-preview-trade data-side="Buy">Preview buy</button>
            <button class="sell-button" type="button" data-preview-trade data-side="Sell">Preview sell</button>
          </div>
          <p class="paper-note"><span>•</span> Simulation only. No broker account is connected.</p>
        </article>

        <article class="panel guardrail-panel">
          <div class="guardrail-head">
            <div>
              <div class="panel-kicker">Risk guardrails</div>
              <h2>Protected by rules</h2>
            </div>
            <span class="all-clear">All clear</span>
          </div>
          <div class="guardrail-list">
            <div>
              <span class="guardrail-check">✓</span>
              <p><strong>Daily loss cap</strong><small>$140 used of $300 maximum</small></p>
              <b>47%</b>
            </div>
            <div>
              <span class="guardrail-check">✓</span>
              <p><strong>Trade frequency</strong><small>2 of 5 trades placed today</small></p>
              <b>2 / 5</b>
            </div>
            <div>
              <span class="guardrail-check">✓</span>
              <p><strong>Open exposure</strong><small>No open simulated positions</small></p>
              <b>Clear</b>
            </div>
          </div>
        </article>
      </aside>
    </div>

    <div class="lower-grid">
      <article class="panel journal-panel" id="journal">
        <div class="panel-head compact">
          <div>
            <div class="panel-kicker">Decision journal</div>
            <h2>Recent analysis</h2>
          </div>
          <button class="text-button" type="button">View all <span>→</span></button>
        </div>
        <div class="journal-table">
          <div class="journal-row journal-headings"><span>Time</span><span>Signal</span><span>Confidence</span><span>Why it happened</span><span>Outcome</span></div>
          <div class="journal-row"><span>14:00</span><span><b class="signal-badge wait">Wait</b></span><span>64%</span><span>Range still intact; no clean breakout.</span><span class="muted">Monitoring</span></div>
          <div class="journal-row"><span>13:45</span><span><b class="signal-badge buy">Buy</b></span><span>78%</span><span>MACD crossed above zero with sentiment support.</span><span class="positive">+$31.20</span></div>
          <div class="journal-row"><span>13:30</span><span><b class="signal-badge wait">Wait</b></span><span>59%</span><span>High-impact USD data approaching.</span><span class="muted">Skipped</span></div>
        </div>
      </article>

      <article class="panel principle-panel">
        <span class="principle-mark">“</span>
        <p>A smart system analyzes every 15 minutes, but only acts when the opportunity is strong.</p>
        <span>GoldPulse principle</span>
      </article>
    </div>

    <div class="toast" data-trade-toast role="status" aria-live="polite"></div>
  </section>
</Layout>

<script>
  const durationPlans = {
    '5': {
      summary: '5-minute quick setup',
      takeProfit: '$2,179.06',
      stopLoss: '$2,173.18',
      potentialProfit: '+$18.20 potential',
      potentialLoss: '-$8.70 max loss',
      ratio: '1 : 2.1',
    },
    '10': {
      summary: '10-minute balanced setup',
      takeProfit: '$2,181.30',
      stopLoss: '$2,172.48',
      potentialProfit: '+$29.40 potential',
      potentialLoss: '-$14.70 max loss',
      ratio: '1 : 2.0',
    },
    '15': {
      summary: '15-minute extended setup',
      takeProfit: '$2,183.94',
      stopLoss: '$2,171.64',
      potentialProfit: '+$42.60 potential',
      potentialLoss: '-$21.30 max loss',
      ratio: '1 : 2.0',
    },
  };

  let selectedDuration = '10';
  const durationButtons = document.querySelectorAll('[data-duration]');
  const durationSummary = document.querySelector('[data-duration-summary]');
  const takeProfit = document.querySelector('[data-take-profit]');
  const stopLoss = document.querySelector('[data-stop-loss]');
  const potentialProfit = document.querySelector('[data-potential-profit]');
  const potentialLoss = document.querySelector('[data-potential-loss]');
  const riskRatio = document.querySelector('[data-risk-ratio]');
  const toast = document.querySelector('[data-trade-toast]');

  function setDuration(duration) {
    const plan = durationPlans[duration];
    if (!plan) return;

    selectedDuration = duration;
    durationButtons.forEach((button) => {
      const isSelected = button.getAttribute('data-duration') === duration;
      button.classList.toggle('selected', isSelected);
      button.setAttribute('aria-pressed', String(isSelected));
    });

    durationSummary.textContent = plan.summary;
    takeProfit.textContent = plan.takeProfit;
    stopLoss.textContent = plan.stopLoss;
    potentialProfit.textContent = plan.potentialProfit;
    potentialLoss.textContent = plan.potentialLoss;
    riskRatio.textContent = plan.ratio;
  }

  durationButtons.forEach((button) => {
    button.addEventListener('click', () => setDuration(button.getAttribute('data-duration') || '10'));
  });

  document.querySelectorAll('[data-chart-range]').forEach((button) => {
    button.addEventListener('click', () => {
      document.querySelectorAll('[data-chart-range]').forEach((rangeButton) => rangeButton.classList.remove('selected'));
      button.classList.add('selected');
    });
  });

  document.querySelectorAll('[data-preview-trade]').forEach((button) => {
    button.addEventListener('click', () => {
      const side = button.getAttribute('data-side');
      toast.textContent = `${side} paper ticket prepared for a ${selectedDuration}-minute setup. No order was sent.`;
      toast.classList.add('visible');
      window.setTimeout(() => toast.classList.remove('visible'), 3800);
    });
  });

  const analysisButton = document.querySelector('[data-run-analysis]');
  const analysisStatus = document.querySelector('[data-analysis-status]');
  const countdown = document.querySelector('[data-countdown]');

  analysisButton.addEventListener('click', () => {
    analysisButton.setAttribute('disabled', 'true');
    analysisStatus.textContent = 'Scanning technicals and headlines…';
    countdown.textContent = '00:00';

    window.setTimeout(() => {
      analysisButton.removeAttribute('disabled');
      analysisStatus.textContent = 'Updated just now';
      countdown.textContent = '15:00';
    }, 900);
  });
</script>

<style>
  .dashboard {
    display: grid;
    gap: 20px;
  }

  .intro-row,
  .panel-head,
  .decision-top,
  .guardrail-head,
  .metric-heading,
  .field-label,
  .plan-price,
  .position-row,
  .ratio-row,
  .journal-row,
  .instrument-title,
  .chart-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .intro-row {
    min-height: 142px;
    gap: 28px;
    padding: 12px 2px 8px;
  }

  .eyebrow,
  .panel-kicker {
    color: #9ba99f;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.105em;
    text-transform: uppercase;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #d6c17d;
  }

  .eyebrow span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e8c46b;
    box-shadow: 0 0 0 4px rgba(232, 196, 107, 0.11);
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    max-width: 650px;
    margin-top: 12px;
    color: #f3f5ee;
    font-size: clamp(2rem, 4vw, 3.45rem);
    font-weight: 650;
    letter-spacing: -0.065em;
    line-height: 0.99;
  }

  h1 em {
    color: #e9c870;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 500;
  }

  .intro-copy {
    max-width: 585px;
    margin-top: 15px;
    color: #9ba9a1;
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .scan-card {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 12px;
    min-width: 254px;
    padding: 13px 12px;
    border: 1px solid rgba(151, 181, 159, 0.14);
    border-radius: 14px;
    background: rgba(18, 36, 30, 0.6);
    box-shadow: 0 16px 35px rgba(0, 0, 0, 0.1);
  }

  .scan-orb {
    display: grid;
    width: 43px;
    height: 43px;
    place-items: center;
    border: 1px solid rgba(105, 218, 166, 0.25);
    border-radius: 13px;
    color: #7de4b0;
    background: rgba(33, 124, 85, 0.12);
  }

  .scan-orb svg {
    width: 31px;
    height: 31px;
  }

  .scan-card > div:nth-child(2) {
    display: grid;
    gap: 1px;
  }

  .scan-card span,
  .scan-card small {
    color: #87988e;
    font-size: 0.69rem;
  }

  .scan-card strong {
    color: #f0f4ec;
    font-size: 1.17rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .icon-button {
    display: grid;
    width: 32px;
    height: 32px;
    margin-left: 5px;
    place-items: center;
    border: 1px solid rgba(146, 180, 155, 0.18);
    border-radius: 9px;
    color: #adc0b3;
    background: rgba(255, 255, 255, 0.035);
    transition: color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .icon-button:hover {
    border-color: rgba(233, 199, 106, 0.5);
    color: #e8c66e;
    transform: rotate(25deg);
  }

  .icon-button:disabled {
    cursor: wait;
    opacity: 0.45;
  }

  .icon-button svg {
    width: 17px;
    height: 17px;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: 1.16fr repeat(3, 1fr);
    gap: 14px;
  }

  .metric-card,
  .panel {
    border: 1px solid rgba(153, 184, 162, 0.13);
    background:
      linear-gradient(145deg, rgba(23, 45, 37, 0.76), rgba(10, 25, 20, 0.67)),
      rgba(13, 31, 25, 0.62);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025), 0 20px 45px rgba(0, 0, 0, 0.09);
    backdrop-filter: blur(14px);
  }

  .metric-card {
    min-height: 142px;
    padding: 16px 17px 14px;
    border-radius: 15px;
  }

  .balance-card {
    background:
      radial-gradient(circle at 96% 9%, rgba(225, 193, 103, 0.12), transparent 35%),
      linear-gradient(145deg, rgba(39, 57, 40, 0.82), rgba(14, 28, 22, 0.72));
  }

  .metric-heading {
    color: #95a49b;
    font-size: 0.73rem;
    font-weight: 590;
  }

  .metric-icon {
    display: grid;
    width: 25px;
    height: 25px;
    place-items: center;
    border-radius: 8px;
  }

  .metric-icon svg {
    width: 15px;
    height: 15px;
  }

  .metric-icon.gold {
    color: #ebcd7c;
    background: rgba(224, 183, 76, 0.11);
  }

  .metric-icon.green {
    color: #6bdfaa;
    background: rgba(55, 201, 137, 0.1);
  }

  .metric-icon.blue {
    color: #82c8ef;
    background: rgba(82, 172, 221, 0.11);
  }

  .metric-icon.coral {
    color: #edaa91;
    background: rgba(216, 114, 87, 0.1);
  }

  .metric-card > strong {
    display: block;
    margin-top: 14px;
    color: #f1f4ee;
    font-size: 1.47rem;
